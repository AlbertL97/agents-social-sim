# Copy to `.env` for local runs. NEVER commit real values.
# In production these are GitHub Actions encrypted secrets -> env vars.

# ---- LLM (Google Gemini) ----------------------------------------------------
# Required for real simulation runs. If UNSET, the app auto-enables --dry-run
# and uses a deterministic stub LLM + stub embedder (no network, no key).
# Do NOT enable billing on the Google Cloud project behind this key.
GEMINI_API_KEY=

# Dialogue / reasoning model. Locked to the Gemini Flash family.
# (gemini-2.0-flash is shut down — do not use it.)
GEMINI_MODEL=gemini-3.6-flash

# Embedding model for Concordia associative memory.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Budget / cadence (HARD limits the scheduler enforces) -----------------
# Daily request cap. RPD is the binding constraint for free-tier 24/7 operation.
DAILY_REQUEST_BUDGET=1000

# Per-entity turn interval in seconds (60-minute cycle).
TURN_INTERVAL_SECONDS=3600

# Minimum spacing between consecutive Gemini calls in seconds (respects RPM).
MIN_CALL_SPACING_SECONDS=6

# Max LLM calls a single cron run may make (keeps each ephemeral run bounded).
MAX_CALLS_PER_RUN=40

# Size of the working-memory window reconstructed per entity each tick
# (last N turns verbatim + a running summary of earlier turns). Everything
# stays durable in sim_turn_log; this cap is only for the in-context window.
MEMORY_WINDOW_TURNS=20

# ---- Supabase (Free Postgres persistence) ----------------------------------
# If SUPABASE_URL is UNSET, the app writes to a local JSON file instead, so the
# full pipeline is testable without Supabase.
SUPABASE_URL=
# service_role key — used ONLY in GitHub Actions for writes. Never expose publicly.
SUPABASE_SERVICE_KEY=
# anon key — used by the read-only static frontend (RLS: SELECT-only).
SUPABASE_ANON_KEY=

# Local-JSON backend path (used when SUPABASE_URL is unset).
LOCAL_STATE_DIR=./.local-state
